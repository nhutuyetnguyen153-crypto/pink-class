rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || isTeacher());
      allow list: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher()
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /students/{studentId} {
      function validStudentData() {
        return request.resource.data.keys().hasOnly([
          'name', 'email', 'className', 'status', 'notes',
          'teacherUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'className', 'status', 'notes',
          'teacherUid', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 60
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.status in ['active', 'paused']
        && request.resource.data.teacherUid == request.auth.uid;
      }

      allow read: if isTeacher()
        && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher()
        && validStudentData()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isTeacher()
        && resource.data.teacherUid == request.auth.uid
        && validStudentData()
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
