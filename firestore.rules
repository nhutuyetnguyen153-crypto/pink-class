rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function owns(data) { return isTeacher() && data.teacherUid == request.auth.uid; }
    function studentOwns(studentUid) {
      return signedIn() && studentUid == request.auth.uid
        && (
          (exists(/databases/$(database)/documents/students/$(request.auth.uid))
            && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.authUid == request.auth.uid
            && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active')
          ||
          (exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid))
            && exists(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId))
            && get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)).data.authUid == request.auth.uid
            && get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)).data.status == 'active')
        );
    }
    function badgeReward(badgeId) {
      return badgeId == 'first' ? 5 : badgeId == 'streak3' ? 10 : badgeId == 'streak7' ? 50 : badgeId == 'streak14' ? 80 : badgeId == 'streak30' ? 150 : badgeId == 'days10' ? 20 : badgeId == 'days20' ? 40 : badgeId == 'days30' ? 60 : badgeId == 'submit5' ? 15 : badgeId == 'submit20' ? 40 : badgeId == 'submit50' ? 100 : badgeId == 'vocab7' ? 30 : badgeId == 'grammar10' ? 35 : badgeId == 'points300' ? 20 : badgeId == 'points1000' ? 100 : 0;
    }
    function studentOfTeacher(teacherUid) {
      return signedIn()
        && (
          (exists(/databases/$(database)/documents/students/$(request.auth.uid))
            && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.authUid == request.auth.uid
            && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.teacherUid == teacherUid
            && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active')
          ||
          (exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid))
            && get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.teacherUid == teacherUid
            && exists(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId))
            && get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)).data.authUid == request.auth.uid
            && get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)).data.status == 'active')
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isTeacher());
      allow list: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher() && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /students/{studentId} {
      function validStudentData() {
        return request.resource.data.keys().hasOnly(['name','email','className','status','notes','teacherUid','authUid','pointsBalance','streak','streakFreezes','extraSpins','avatarId','avatarChangeId','createdAt','updatedAt'])
          && request.resource.data.keys().hasAll(['name','email','className','status','notes','teacherUid','authUid','pointsBalance','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.email is string && request.resource.data.email.size() <= 160
          && request.resource.data.className is string && request.resource.data.className.size() <= 60
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
          && request.resource.data.status in ['active','paused']
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.authUid is string
          && request.resource.data.pointsBalance is number && request.resource.data.pointsBalance >= 0;
      }
      allow get: if (isTeacher() && owns(resource.data)) || (signedIn() && request.auth.uid == studentId) || (signedIn() && resource.data.authUid == request.auth.uid && exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)) && get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId == studentId);
      allow list: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create: if isTeacher() && validStudentData()
        && request.resource.data.authUid == studentId
        && request.resource.data.pointsBalance == 0
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if (owns(resource.data) || (signedIn() && (request.auth.uid == studentId || resource.data.authUid == request.auth.uid)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','className','status','notes','teacherUid','authUid','pointsBalance','streak','streakFreezes','extraSpins','avatarId','avatarChangeId','badgeClaimId','streakFreezePurchaseMonth','streakFreezeMonthlyCount','goalBonusId','vocabDailyClaimId','reflectionRewardSubmissionId','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['name','email','className','status','notes','teacherUid','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.className is string && request.resource.data.className.size() <= 60
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && request.resource.data.status in ['active','paused']
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.createdAt == resource.data.createdAt
        && ((!('authUid' in resource.data) && (!('authUid' in request.resource.data) || request.resource.data.authUid == '' || (existsAfter(/databases/$(database)/documents/studentAccounts/$(request.resource.data.authUid)) && getAfter(/databases/$(database)/documents/studentAccounts/$(request.resource.data.authUid)).data.studentId == studentId && getAfter(/databases/$(database)/documents/studentAccounts/$(request.resource.data.authUid)).data.teacherUid == request.auth.uid))) || (('authUid' in resource.data) && request.resource.data.authUid == resource.data.authUid))
        && (!('pointsBalance' in request.resource.data) || (request.resource.data.pointsBalance is number && request.resource.data.pointsBalance >= -1000000))
        && (!('streak' in request.resource.data) || (request.resource.data.streak is int && request.resource.data.streak >= 0 && request.resource.data.streak <= 9999))
        && request.resource.data.updatedAt == request.time
        && (isTeacher() ||
          (signedIn()
            && (request.auth.uid == studentId || resource.data.authUid == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance','streakFreezes','extraSpins','avatarId','avatarChangeId','badgeClaimId','streakFreezePurchaseMonth','streakFreezeMonthlyCount','goalBonusId','vocabDailyClaimId','reflectionRewardSubmissionId','updatedAt'])
            && (
              (request.resource.data.pointsBalance == resource.data.pointsBalance - 20
                && request.resource.data.avatarId is string
                && request.resource.data.avatarId in ['🐻','🐰','🐱','🐼','🦊','🐸','🐨','🐯','🐧','🦄','🐥','🐹']
                && request.resource.data.avatarId != resource.data.get('avatarId', '🐻')
                && request.resource.data.avatarChangeId is string
                && existsAfter(/databases/$(database)/documents/scoreEvents/$('avatar-' + request.resource.data.avatarChangeId))
                && getAfter(/databases/$(database)/documents/scoreEvents/$('avatar-' + request.resource.data.avatarChangeId)).data.studentId == studentId
                && getAfter(/databases/$(database)/documents/scoreEvents/$('avatar-' + request.resource.data.avatarChangeId)).data.points == -20
                && getAfter(/databases/$(database)/documents/scoreEvents/$('avatar-' + request.resource.data.avatarChangeId)).data.submissionId == 'avatar-' + request.resource.data.avatarChangeId)
              ||
              (request.resource.data.pointsBalance == resource.data.pointsBalance - 20
                && request.resource.data.get('streakFreezes', 0) == resource.data.get('streakFreezes', 0) + 1
                && request.resource.data.get('extraSpins', 0) == resource.data.get('extraSpins', 0)
                && request.resource.data.streakFreezePurchaseMonth is string
                && request.resource.data.streakFreezeMonthlyCount is int
                && request.resource.data.streakFreezeMonthlyCount <= 3
                && ((request.resource.data.streakFreezePurchaseMonth == resource.data.get('streakFreezePurchaseMonth', '')
                    && request.resource.data.streakFreezeMonthlyCount == resource.data.get('streakFreezeMonthlyCount', 0) + 1)
                  || (request.resource.data.streakFreezePurchaseMonth != resource.data.get('streakFreezePurchaseMonth', '')
                    && request.resource.data.streakFreezeMonthlyCount == 1)))
              ||
              (request.resource.data.pointsBalance == resource.data.pointsBalance - 300
                && request.resource.data.get('streakFreezes', 0) == resource.data.get('streakFreezes', 0)
                && (request.resource.data.get('extraSpins', 0) == resource.data.get('extraSpins', 0)
                  || request.resource.data.get('extraSpins', 0) == resource.data.get('extraSpins', 0) + 1))
              ||
              (request.resource.data.pointsBalance == resource.data.pointsBalance
                && request.resource.data.get('streakFreezes', 0) == resource.data.get('streakFreezes', 0)
                && (request.resource.data.get('extraSpins', 0) == resource.data.get('extraSpins', 0) - 1
                  || request.resource.data.get('extraSpins', 0) == resource.data.get('extraSpins', 0)))
              ||
              (request.resource.data.pointsBalance > resource.data.pointsBalance
                && request.resource.data.pointsBalance - resource.data.pointsBalance <= 150
                && existsAfter(/databases/$(database)/documents/badgeClaims/$(studentId + '_' + request.resource.data.badgeClaimId))
                && getAfter(/databases/$(database)/documents/badgeClaims/$(studentId + '_' + request.resource.data.badgeClaimId)).data.points == request.resource.data.pointsBalance - resource.data.pointsBalance)
               ||
               (request.resource.data.pointsBalance == resource.data.pointsBalance + 10
                 && request.resource.data.vocabDailyClaimId is string
                 && existsAfter(/databases/$(database)/documents/vocabDaily/$(request.resource.data.vocabDailyClaimId))
                 && getAfter(/databases/$(database)/documents/vocabDaily/$(request.resource.data.vocabDailyClaimId)).data.studentId == studentId
                 && getAfter(/databases/$(database)/documents/vocabDaily/$(request.resource.data.vocabDailyClaimId)).data.points == 10
                 && existsAfter(/databases/$(database)/documents/scoreEvents/$('vocab-day-' + request.resource.data.vocabDailyClaimId))
                 && getAfter(/databases/$(database)/documents/scoreEvents/$('vocab-day-' + request.resource.data.vocabDailyClaimId)).data.points == 10)
               ||
               (request.resource.data.pointsBalance == resource.data.pointsBalance + 30
                 && request.resource.data.reflectionRewardSubmissionId is string
                 && request.resource.data.reflectionRewardSubmissionId != resource.data.get('reflectionRewardSubmissionId', '')
                 && existsAfter(/databases/$(database)/documents/submissions/$(request.resource.data.reflectionRewardSubmissionId))
                 && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.reflectionRewardSubmissionId)).data.studentId == studentId
                 && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.reflectionRewardSubmissionId)).data.reflectionRewardClaimed == true
                 && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.reflectionRewardSubmissionId)).data.reflectionText is string
                 && existsAfter(/databases/$(database)/documents/scoreEvents/$('reflection-' + request.resource.data.reflectionRewardSubmissionId))
                 && getAfter(/databases/$(database)/documents/scoreEvents/$('reflection-' + request.resource.data.reflectionRewardSubmissionId)).data.points == 30)
               ||
               (request.resource.data.pointsBalance > resource.data.pointsBalance
                 && request.resource.data.pointsBalance - resource.data.pointsBalance <= 20000
                 && request.resource.data.goalBonusId is string
                 && existsAfter(/databases/$(database)/documents/learningGoals/$(request.resource.data.goalBonusId))
                 && getAfter(/databases/$(database)/documents/learningGoals/$(request.resource.data.goalBonusId)).data.status == 'completed'
                 && getAfter(/databases/$(database)/documents/learningGoals/$(request.resource.data.goalBonusId)).data.bonusPoints == request.resource.data.pointsBalance - resource.data.pointsBalance
                 && existsAfter(/databases/$(database)/documents/scoreEvents/$('goal-bonus-' + request.resource.data.goalBonusId))
                 && getAfter(/databases/$(database)/documents/scoreEvents/$('goal-bonus-' + request.resource.data.goalBonusId)).data.points == request.resource.data.pointsBalance - resource.data.pointsBalance)
            )
          )
        );
      allow delete: if owns(resource.data);
    }

    match /studentAccounts/{accountUid} {
      allow get: if signedIn() && request.auth.uid == accountUid;
      allow list: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['authUid','studentId','teacherUid','createdAt'])
        && request.resource.data.keys().hasAll(['authUid','studentId','teacherUid','createdAt'])
        && request.resource.data.authUid == accountUid
        && request.resource.data.studentId is string
        && request.resource.data.teacherUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.authUid == accountUid
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /rewards/{rewardId} {
      allow read: if owns(resource.data) || studentOfTeacher(resource.data.teacherUid);
      allow create: if isTeacher() && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.pointsCost is int && request.resource.data.pointsCost > 0 && request.resource.data.pointsCost <= 10000
        && request.resource.data.imageData is string && request.resource.data.imageData.size() <= 650000
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owns(resource.data) && owns(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.pointsCost is int && request.resource.data.pointsCost > 0 && request.resource.data.pointsCost <= 10000
        && request.resource.data.imageData is string && request.resource.data.imageData.size() <= 650000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(resource.data);
    }

    match /redemptions/{redemptionId} {
      allow read: if owns(resource.data) || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && studentOwns(request.auth.uid)
        && request.resource.data.keys().hasOnly(['studentUid','studentId','studentName','teacherUid','rewardId','rewardTitle','pointsCost','status','requestedAt'])
        && request.resource.data.studentUid == request.auth.uid
        && ((request.resource.data.studentId == request.auth.uid && exists(/databases/$(database)/documents/students/$(request.auth.uid)) && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.authUid == request.auth.uid) || (exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)) && request.resource.data.studentId == get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId))
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && request.resource.data.rewardId is string
        && exists(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId))
        && get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.teacherUid == request.resource.data.teacherUid
        && get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.active == true
        && get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.pointsCost == request.resource.data.pointsCost
        && request.resource.data.studentName == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.name
        && request.resource.data.rewardTitle == get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.title
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if isTeacher() && owns(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.rewardId == resource.data.rewardId
        && request.resource.data.pointsCost == resource.data.pointsCost
        && request.resource.data.requestedAt == resource.data.requestedAt
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','processedBy','processedAt'])
        && (
          (request.resource.data.status == 'approved'
            && getAfter(/databases/$(database)/documents/students/$(resource.data.studentId)).data.pointsBalance
              == get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.pointsBalance - resource.data.pointsCost
            && existsAfter(/databases/$(database)/documents/scoreEvents/$(redemptionId))
            && getAfter(/databases/$(database)/documents/scoreEvents/$(redemptionId)).data.studentId == resource.data.studentId
            && getAfter(/databases/$(database)/documents/scoreEvents/$(redemptionId)).data.points == -resource.data.pointsCost
            && getAfter(/databases/$(database)/documents/scoreEvents/$(redemptionId)).data.teacherUid == request.auth.uid)
          ||
          (request.resource.data.status == 'rejected'
            && getAfter(/databases/$(database)/documents/students/$(resource.data.studentId)).data.pointsBalance
              == get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.pointsBalance)
        );
      allow delete: if false;
    }

    match /vocabularySets/{docId} {
      allow read: if owns(resource.data) || studentOfTeacher(resource.data.teacherUid);
      allow create: if isTeacher() && owns(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.words is string && request.resource.data.words.size() <= 12000
        && (!('flashcardUrl' in request.resource.data) || (request.resource.data.flashcardUrl is string && request.resource.data.flashcardUrl.size() <= 2000))
        && (!('vocabularyUrl' in request.resource.data) || (request.resource.data.vocabularyUrl is string && request.resource.data.vocabularyUrl.size() <= 2000))
        && (!('dueDate' in request.resource.data) || (request.resource.data.dueDate is string && request.resource.data.dueDate.size() <= 40))
        && request.resource.data.className is string
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owns(resource.data) && owns(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.words is string && request.resource.data.words.size() <= 12000
        && (!('flashcardUrl' in request.resource.data) || (request.resource.data.flashcardUrl is string && request.resource.data.flashcardUrl.size() <= 2000))
        && (!('vocabularyUrl' in request.resource.data) || (request.resource.data.vocabularyUrl is string && request.resource.data.vocabularyUrl.size() <= 2000))
        && (!('dueDate' in request.resource.data) || (request.resource.data.dueDate is string && request.resource.data.dueDate.size() <= 40))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(resource.data);
    }
    match /assignments/{docId} {
      allow read: if owns(resource.data) || studentOfTeacher(resource.data.teacherUid);
      allow create: if isTeacher() && owns(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.description is string && request.resource.data.description.size() <= 4000
        && (!("assignmentLink" in request.resource.data) || (request.resource.data.assignmentLink is string && request.resource.data.assignmentLink.size() <= 2000))
        && request.resource.data.className is string
        && request.resource.data.dueDate is string
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owns(resource.data) && owns(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.description is string && request.resource.data.description.size() <= 4000
        && (!("assignmentLink" in request.resource.data) || (request.resource.data.assignmentLink is string && request.resource.data.assignmentLink.size() <= 2000))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(resource.data);
    }
    match /submissions/{docId} {
      function isLinkedStudentSubmission() {
        return studentOwns(request.auth.uid)
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.studentId == (exists(/databases/$(database)/documents/students/$(request.auth.uid))
            ? request.auth.uid
            : get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)
          && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
          && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid == request.resource.data.teacherUid
          && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.name == request.resource.data.studentName
          && ((exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
            && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.teacherUid == request.resource.data.teacherUid
            && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.title == request.resource.data.assignmentTitle
            && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.className in ['', 'Tất cả', get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.className])
          || (exists(/databases/$(database)/documents/vocabularySets/$(request.resource.data.assignmentId))
            && get(/databases/$(database)/documents/vocabularySets/$(request.resource.data.assignmentId)).data.teacherUid == request.resource.data.teacherUid
            && get(/databases/$(database)/documents/vocabularySets/$(request.resource.data.assignmentId)).data.title == request.resource.data.assignmentTitle
            && get(/databases/$(database)/documents/vocabularySets/$(request.resource.data.assignmentId)).data.className in ['', 'Tất cả', get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.className]))
          && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 650000;
      }
      allow read: if owns(resource.data)
        || (studentOwns(request.auth.uid) && resource.data.studentUid == request.auth.uid);
      allow create: if (isTeacher() && owns(request.resource.data)
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentTitle is string
        && request.resource.data.imageUrl is string
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.status == 'submitted'
        && request.resource.data.score == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time)
        || (isLinkedStudentSubmission()
        && request.resource.data.teacherUid is string
        && request.resource.data.studentName is string
        && request.resource.data.assignmentTitle is string
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.status == 'submitted'
        && request.resource.data.score == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      allow update: if (owns(resource.data) && owns(request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.assignmentId == resource.data.assignmentId
        && (request.resource.data.imageUrl == resource.data.imageUrl || (request.resource.data.imageUrl == '' && resource.data.createdAt is timestamp && resource.data.createdAt <= request.time - duration.value(7, 'd')))
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.score == null || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100)))
        || (signedIn() && studentOwns(request.auth.uid)
          && resource.data.studentUid == request.auth.uid
          && resource.data.status == 'graded' && resource.data.score is number
          && resource.data.get('reflectionRewardClaimed', false) == false
          && request.resource.data.reflectionRewardClaimed == true
          && request.resource.data.reflectionText is string
          && request.resource.data.reflectionText.size() >= 10
          && request.resource.data.reflectionText.size() <= 3000
          && request.resource.data.reflectionSubmittedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reflectionText','reflectionSubmittedAt','reflectionRewardClaimed','updatedAt'])
          && getAfter(/databases/$(database)/documents/students/$(resource.data.studentId)).data.pointsBalance == get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.pointsBalance + 30
          && getAfter(/databases/$(database)/documents/students/$(resource.data.studentId)).data.reflectionRewardSubmissionId == docId
          && existsAfter(/databases/$(database)/documents/scoreEvents/$('reflection-' + docId))
          && getAfter(/databases/$(database)/documents/scoreEvents/$('reflection-' + docId)).data.points == 30);
      allow delete: if owns(resource.data);
    }
    match /studentRequests/{requestId} {
      allow read: if (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && studentOwns(request.auth.uid)
        && request.resource.data.keys().hasOnly(['teacherUid','studentUid','studentId','studentName','type','assignmentId','assignmentTitle','requestedDueDate','absenceDate','reason','status','requestedAt'])
        && request.resource.data.keys().hasAll(['teacherUid','studentUid','studentId','studentName','type','assignmentId','assignmentTitle','requestedDueDate','absenceDate','reason','status','requestedAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == (exists(/databases/$(database)/documents/students/$(request.auth.uid))
          ? request.auth.uid
          : get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid == request.resource.data.teacherUid
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && request.resource.data.studentName == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.name
        && request.resource.data.type in ['extension','late_explanation','absence','streak_recovery']
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1200
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentTitle is string
        && request.resource.data.requestedDueDate is string
        && request.resource.data.absenceDate is string
        && (request.resource.data.type in ['absence','streak_recovery']
          || (exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
            && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.teacherUid == request.resource.data.teacherUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if isTeacher()
        && resource.data.teacherUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.type == resource.data.type
        && request.resource.data.assignmentId == resource.data.assignmentId
        && request.resource.data.requestedDueDate == resource.data.requestedDueDate
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time
        && request.resource.data.teacherNote is string
        && request.resource.data.teacherNote.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','teacherNote','processedAt','processedBy']);
      allow delete: if false;
    }
    match /learningGoals/{goalId} {
      allow read: if owns(resource.data) || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn() && studentOwns(request.auth.uid)
        && request.resource.data.keys().hasOnly(['teacherUid','studentUid','studentId','studentName','period','goalPoints','startAt','endAt','status','bonusPoints','createdAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == (exists(/databases/$(database)/documents/students/$(request.auth.uid)) ? request.auth.uid : get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && request.resource.data.studentName == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.name
        && request.resource.data.period in ['week','month']
        && request.resource.data.goalPoints is int && request.resource.data.goalPoints >= 10 && request.resource.data.goalPoints <= 100000
        && request.resource.data.startAt is string && request.resource.data.endAt is string
        && request.resource.data.status == 'active' && request.resource.data.bonusPoints == 0
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','bonusPoints','completedAt','updatedAt'])
        && request.resource.data.status in ['completed','expired','reset']
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == 'expired' || request.resource.data.status == 'reset'
          || (request.resource.data.bonusPoints is int && request.resource.data.bonusPoints > 0 && request.resource.data.bonusPoints <= 20000
            && existsAfter(/databases/$(database)/documents/scoreEvents/$('goal-bonus-' + goalId))
            && getAfter(/databases/$(database)/documents/scoreEvents/$('goal-bonus-' + goalId)).data.points == request.resource.data.bonusPoints));
      allow delete: if false;
    }
    match /pointExchangeRequests/{requestId} {
      allow read: if (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn() && studentOwns(request.auth.uid)
        && request.resource.data.keys().hasOnly(['teacherUid','studentUid','studentId','studentName','pointsAmount','reason','status','createdAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == (exists(/databases/$(database)/documents/students/$(request.auth.uid)) ? request.auth.uid : get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && request.resource.data.studentName == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.name
        && request.resource.data.pointsAmount is int && request.resource.data.pointsAmount > 0
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','processedAt','processedBy']);
      allow delete: if false;
    }
    match /vocabDaily/{dailyId} {
      allow get: if (signedIn() && dailyId.matches('^' + request.auth.uid + '_.+'))
        || (signedIn() && exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid))
          && dailyId.matches('^' + get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId + '_.+'))
        || owns(resource.data)
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow list: if owns(resource.data) || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teacherUid','studentUid','studentId','studentName','setId','setTitle','dayOffset','dayKey','imageUrl','completed','points','submittedAt','createdAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.status == 'active'
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && exists(/databases/$(database)/documents/vocabularySets/$(request.resource.data.setId))
        && get(/databases/$(database)/documents/vocabularySets/$(request.resource.data.setId)).data.teacherUid == request.resource.data.teacherUid
        && request.resource.data.dayOffset in [1,3,5,7,14,21,30]
        && request.resource.data.dayKey is string
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 650000
        && request.resource.data.completed == true && request.resource.data.points == 10
        && request.resource.data.submittedAt == request.time && request.resource.data.createdAt == request.time;
      allow update: if owns(resource.data) && owns(request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.setId == resource.data.setId
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.completed == resource.data.completed
        && request.resource.data.points == resource.data.points
        && request.resource.data.imageUrl == ''
        && request.resource.data.imageDeletedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl','imageDeletedAt','updatedAt']);
      allow delete: if false;
    }
    match /scoreEvents/{docId} {
      allow read: if owns(resource.data) || (signedIn() && (resource.data.studentId == request.auth.uid || (exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)) && get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId == resource.data.studentId)));
      allow create: if (isTeacher() && owns(request.resource.data)
        && request.resource.data.studentId is string
        && request.resource.data.submissionId is string
        && request.resource.data.points is number
        && request.resource.data.points >= -10000 && request.resource.data.points <= 10000
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid == request.auth.uid
        && request.resource.data.createdAt == request.time)
        || (signedIn()
          && request.resource.data.keys().hasOnly(['teacherUid','studentId','submissionId','points','note','createdAt'])
          && request.resource.data.studentId is string
          && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
          && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.authUid == request.auth.uid
          && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.status == 'active'
          && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
          && request.resource.data.submissionId is string
          && (request.resource.data.submissionId.matches('^wheel-.*$')
            || request.resource.data.submissionId.matches('^badge-.*$')
            || request.resource.data.submissionId.matches('^streak-freeze-.*$')
            || request.resource.data.submissionId.matches('^vocab-day-.*$')
            || request.resource.data.submissionId.matches('^goal-bonus-.*$')
            || request.resource.data.submissionId.matches('^avatar-.*$')
             || request.resource.data.submissionId.matches('^reflection-.*$'))
          && request.resource.data.points is number
          && request.resource.data.points >= -300
          && ((request.resource.data.submissionId.matches('^goal-bonus-.*$') && request.resource.data.points <= 20000)
             || (request.resource.data.submissionId.matches('^reflection-.*$') && request.resource.data.points == 30
               && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.reflectionRewardSubmissionId is string)
            || (!request.resource.data.submissionId.matches('^goal-bonus-.*$') && !request.resource.data.submissionId.matches('^reflection-.*$') && request.resource.data.points <= 150))
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance
            == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance + request.resource.data.points);
      allow update, delete: if false;
    }
    match /wheelSettings/{teacherId} {
      allow read: if isTeacher() && request.auth.uid == teacherId || studentOfTeacher(teacherId);
      allow create, update: if isTeacher() && request.auth.uid == teacherId
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.prizes is list
        && request.resource.data.prizes.size() > 0
        && request.resource.data.prizes.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if isTeacher() && request.auth.uid == teacherId;
    }
    match /wheelRequests/{requestId} {
      allow read: if (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn() && studentOwns(request.auth.uid)
        && request.resource.data.keys().hasOnly(['teacherUid','studentUid','studentId','studentName','freeSpin','pointsBalance','status','requestedAt'])
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == (exists(/databases/$(database)/documents/students/$(request.auth.uid)) ? request.auth.uid : get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)
        && request.resource.data.studentName == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.name
        && request.resource.data.freeSpin is bool
        && ((request.resource.data.freeSpin == true && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.extraSpins > 0)
          || (request.resource.data.freeSpin == false && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance >= 300))
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','processedAt','prizeName'])
        && request.resource.data.processedAt == request.time
        && request.resource.data.prizeName is string;
      allow delete: if false;
    }
    match /wheelSpins/{spinId} {
      allow read: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create: if signedIn() && studentOwns(request.auth.uid)
        && request.resource.data.keys().hasOnly(['teacherUid','studentId','studentUid','studentName','prizeName','prizeType','probability','createdAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == (exists(/databases/$(database)/documents/students/$(request.auth.uid)) ? request.auth.uid : get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId)
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && request.resource.data.prizeName is string
        && request.resource.data.prizeType in ['gift','extra']
        && request.resource.data.probability is number
        && request.resource.data.createdAt == request.time
        && ((getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance - 300)
          || (getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance
            && ((request.resource.data.prizeType == 'gift'
                && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('extraSpins', 0) == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('extraSpins', 0) - 1)
              || (request.resource.data.prizeType == 'extra'
                && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('extraSpins', 0) == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('extraSpins', 0)))));
      allow update, delete: if false;
    }
    match /badgeClaims/{claimId} {
      function studentDocumentId() {
        return exists(/databases/$(database)/documents/students/$(request.auth.uid))
          ? request.auth.uid
          : get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId;
      }
      allow get: if (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && studentOwns(request.auth.uid)
          && claimId.matches('^' + studentDocumentId() + '_.*$'));
      allow list: if (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn() && studentOwns(request.auth.uid)
        && request.resource.data.keys().hasOnly(['studentId','studentUid','teacherUid','badgeId','points','claimedAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == studentDocumentId()
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid
        && request.resource.data.badgeId is string
        && request.resource.data.points == badgeReward(request.resource.data.badgeId)
        && request.resource.data.points > 0
        && request.resource.data.claimedAt == request.time
        && claimId == request.resource.data.studentId + '_' + request.resource.data.badgeId
        && !exists(/databases/$(database)/documents/badgeClaims/$(claimId))
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance
          == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.pointsBalance + request.resource.data.points;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
